{
  "name": "@kamod-ch/dnd",
  "version": "0.1.0",
  "description": "Headless Preact DnD primitives with signals, sortable lists, and accessible keyboard support.",
  "keywords": [
    "accessibility",
    "dnd",
    "drag-and-drop",
    "preact",
    "sortable",
    "typescript"
  ],
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sortable": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>fs.writeFileSync('dist/sortable.js','export * from \\\"./index.js\\\";\\n'))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0"
  },
  "devDependencies": {
    "@preact/signals": "^2.9.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^30.1.3",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.8.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.0.0 || ^11.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
