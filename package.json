{
  "name": "kamod-dnd",
  "version": "0.0.0",
  "private": true,
  "description": "Headless Preact DnD library workspace for @kamod-ch/dnd.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kamod-ch/dnd build",
    "typecheck": "pnpm --filter @kamod-ch/dnd typecheck && pnpm --filter @kamod-ch/dnd build && pnpm --filter './examples/*' typecheck && pnpm --filter './spikes/*' typecheck && pnpm --filter @kamod-ch/dnd-docs typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm --filter @kamod-ch/dnd test",
    "test:browser": "pnpm build && playwright test",
    "test:browser:install": "playwright install chromium firefox webkit",
    "test:tree-browser": "pnpm --filter @kamod-dnd/spike-tree test:e2e",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm docs:check",
    "check:release": "pnpm check && pnpm docs:build && pnpm test:browser && pnpm test:tree-browser && pnpm qa:tarball",
    "spike:build": "pnpm --filter './spikes/*' build",
    "examples:build": "pnpm --filter './examples/*' build",
    "qa:tarball": "node scripts/qa-tarball-consumer.mjs",
    "bench:drag": "node scripts/benchmark-drag.mjs",
    "size:report": "node scripts/bundle-size-report.mjs",
    "docs:dev": "pnpm --filter @kamod-ch/dnd-docs dev",
    "docs:build": "pnpm --filter @kamod-ch/dnd-docs build",
    "docs:check": "pnpm --filter @kamod-ch/dnd-docs check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "brand:readme": "kamod-brand-readme --product DnD --output .github/assets"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@kamod-ch/brand": "^0.4.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
